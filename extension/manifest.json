{
  "manifest_version": 3,
  "name": "CoinGlass Toolkit",
  "version": "0.1.0",
  "description": "Adds features to CoinGlass pages. Unofficial; not affiliated with CoinGlass.",
  "host_permissions": [
    "https://www.coinglass.com/*",
    "https://fapi.binance.com/*",
    "https://www.okx.com/*",
    "https://api.bybit.com/*",
    "https://api.bitget.com/*",
    "https://api.gateio.ws/*",
    "https://contract.mexc.com/*",
    "https://api-futures.kucoin.com/*",
    "https://open-api.bingx.com/*",
    "https://api.hbdm.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.coinglass.com/*"],
      "js": ["modules/impact-cost/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.coinglass.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "modules/index.js",
        "modules/impact-cost/index.js",
        "modules/impact-cost/requests.js",
        "modules/impact-cost/mapping.js",
        "modules/impact-cost/page-hook.js",
        "shared/match.js",
        "shared/impact.js"
      ],
      "matches": ["https://www.coinglass.com/*"]
    }
  ]
}
